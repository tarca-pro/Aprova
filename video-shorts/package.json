{
  "name": "video-shorts",
  "private": true,
  "version": "1.0.0",
  "description": "Template Remotion para shorts de curiosidades (estilo @conexaocuriosa / legendas coloridas)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "prepare-video": "node scripts/prepare.mjs",
    "sfx": "bash scripts/make-sfx.sh",
    "render": "remotion render src/index.ts CuriosidadeShort out/video.mp4 --props=props.json && bash scripts/master.sh out/video.mp4",
    "still": "remotion still src/index.ts CuriosidadeShort out/still.png --props=props.json"
  },
  "dependencies": {
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@remotion/cli": "^4.0.547",
    "@remotion/fonts": "^4.0.547",
    "@remotion/media": "^4.0.547",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.547"
  },
  "devDependencies": {
    "@types/react": "^18.3.32",
    "typescript": "^7.0.2"
  }
}
